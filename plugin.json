{
    "name": "AniWorld Downloader",
    "description": "Displays current download status from AniWorld Downloader.",
    "version": "1.1.0",
    "author": "Tim",
    "entry": "plugin.py",
    "settings_schema": [
        {
            "type": "header",
            "label": "API Configuration"
        },
        {
            "name": "base_url",
            "label": "Base URL",
            "type": "text",
            "default": "http://localhost:8080",
            "info": "The URL of your AniWorld Downloader instance"
        },
        {
            "name": "api_key",
            "label": "API Key",
            "type": "password",
            "info": "Your AniWorld Downloader API key"
        },
        {
            "type": "header",
            "label": "Plugin Options"
        },
        {
            "name": "update_interval",
            "label": "Update Interval (seconds)",
            "type": "number",
            "default": 3,
            "info": "Time in seconds between updates"
        }
    ]
}
